# Copy to .dev.vars for local `wrangler dev` / `vite dev`. Never commit the
# real file - it's already gitignored. In production, set these with
# `wrangler secret put <NAME>` instead of putting them in wrangler.jsonc.

# Stripe secret key (test or live), used server-side only to create
# PaymentIntents. Never expose this in frontend code.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Signing secret for the /api/stripe-webhook endpoint. Get this from the
# Stripe dashboard (or `stripe listen` output) for the webhook you point
# at https://your-domain/api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Supabase service role key. Bypasses RLS - used only by the webhook
# handler to mark an order "paid" after Stripe's signature is verified.
# Never expose this in frontend code or logs.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
